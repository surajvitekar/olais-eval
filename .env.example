# ─── Olais Eval — Environment Variables ─────────────────────────────────────
# Copy this file to .env for development or .env.production for production.
#   cp .env.example .env
#   cp .env.example .env.production

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (update user, password, host, and db name)
DATABASE_URL=postgresql://olais:your_password_here@localhost:5432/olais_eval

# ─── Authentication (Auth.js / NextAuth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-change-me-in-production
# Public-facing URL (use http://localhost:3000 for dev)
NEXTAUTH_URL=http://localhost:3000

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 (separate from AUTH_SECRET)
JWT_SECRET=your-jwt-secret-change-me-in-production

# ─── App Configuration ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Olais Eval
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Campaign Settings ──────────────────────────────────────────────────────
# Maximum number of candidates per evaluation cycle
MAX_PARTICIPANTS=50
# Campaign deadline in ISO 8601 format
CAMPAIGN_DEADLINE=2026-12-31T23:59:59Z
# Whether the leaderboard is publicly visible
LEADERBOARD_PUBLIC=true

# ─── Optional ───────────────────────────────────────────────────────────────
# Set to 1 to disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
