// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  REVIEWER
  HIRING_MANAGER
  CANDIDATE
  READ_ONLY
}

enum UserStatus {
  REGISTERED
  ASSESSMENT_COMPLETED
  PROBLEM_ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  SELECTED
}

enum AssessmentCategory {
  FRONTEND
  BACKEND
  PYTHON
  AI_ML
  API
  DATABASE
  DEVOPS
  UI_UX
  AUTOMATION
  SYSTEM_DESIGN
}

enum QuestionType {
  SELF_RATING
  MULTIPLE_CHOICE
  EXPERIENCE
  PROJECT_FAMILIARITY
  AI_USAGE
}

enum ProblemStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  passwordHash String?
  role        UserRole   @default(CANDIDATE)
  phone       String?
  college     String?
  resumeUrl   String?
  githubUrl   String?
  linkedinUrl String?
  avatarUrl   String?
  status      UserStatus @default(REGISTERED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  invites           Invite[]           @relation("CreatedInvites")
  assessmentResponses AssessmentResponse[]
  skillProfiles     SkillProfile[]
  assignedProblems  AssignedProblem[]
  submissions       Submission[]
  evaluations       Evaluation[]
  leaderboardEntries LeaderboardEntry[]
  auditLogs         AuditLog[]
  candidateInterviews Interview[]      @relation("CandidateInterviews")
  evaluatorInterviews Interview[]      @relation("EvaluatorInterviews")
  interviewEvaluators InterviewEvaluator[]
  interviewScores    InterviewScore[]
  interviewDrafts    InterviewDraft[]
  @@map("user")
}

model Invite {
  id            String   @id @default(cuid())
  code          String   @unique
  candidateName String?
  candidateEmail String?
  maxUses       Int      @default(1)
  usedCount     Int      @default(0)
  expiresAt     DateTime
  sentAt        DateTime?
  createdBy     String
  createdAt     DateTime @default(now())

  creator User @relation("CreatedInvites", fields: [createdBy], references: [id])
  @@map("invite")
}

model AssessmentQuestion {
  id            String             @id @default(cuid())
  category      AssessmentCategory
  questionType  QuestionType
  questionText  String
  options       Json
  weight        Float              @default(1.0)
  displayOrder  Int

  responses AssessmentResponse[]
  @@map("assessment_question")
}

model AssessmentResponse {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  responseValue Json
  createdAt   DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id])
  question AssessmentQuestion  @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@map("assessment_response")
}

model SkillProfile {
  id          String   @id @default(cuid())
  userId      String
  scores      Json
  topSkills   Json
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  @@map("skill_profile")
}

model ProblemTemplate {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  category           String
  difficulty         Int
  overview           String
  requirements       Json
  constraints        Json
  bonusFeatures      Json
  deliverables       Json
  evaluationCriteria Json
  isActive           Boolean  @default(true)
  variantGroup       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedProblems AssignedProblem[]
  @@map("problem_template")
}

model AssignedProblem {
  id                 String        @id @default(cuid())
  userId             String
  problemTemplateId  String
  status             ProblemStatus @default(ASSIGNED)
  variantConfig      Json
  assignedAt         DateTime      @default(now())
  deadline           DateTime?

  user     User            @relation(fields: [userId], references: [id])
  template ProblemTemplate @relation(fields: [problemTemplateId], references: [id])

  submissions Submission[]
  @@map("assigned_problem")
}

model Submission {
  id                   String   @id @default(cuid())
  userId               String
  assignedProblemId    String
  gitUrl               String?
  liveUrl              String?
  architectureNotes    String?
  aiUsageExplanation   String?
  videoUrl             String?
  screenshots          Json
  submittedAt          DateTime @default(now())
  elapsedSeconds       Int?

  user           User             @relation(fields: [userId], references: [id])
  assignedProblem AssignedProblem @relation(fields: [assignedProblemId], references: [id])

  evaluations Evaluation[]

  @@unique([userId, assignedProblemId])
  @@map("submission")
}

model Evaluation {
  id                    String           @id @default(cuid())
  submissionId          String
  evaluatorId           String
  executionScore        Int
  thoughtProcessScore   Int
  architectureScore     Int
  uiUxScore             Int
  aiUsageScore          Int
  deploymentScore       Int
  codeOrganizationScore Int
  communicationScore    Int
  totalScore            Float
  notes                 String?
  status                EvaluationStatus @default(PENDING)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  evaluator  User       @relation(fields: [evaluatorId], references: [id])
  @@map("evaluation")
}

model EvaluationConfig {
  id               String   @id @default(cuid())
  name             String   @default("default")
  dimensionWeights Json
  passingScore     Float    @default(60.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([name])
  @@map("evaluation_config")
}

model LeaderboardEntry {
  id              String   @id @default(cuid())
  userId          String
  cycleId         String
  submissionCount Int      @default(0)
  fastestTime     Int?
  evaluationScore Float?
  interviewScore  Float?
  combinedScore   Float?
  status          String   @default("active")
  hidden          Boolean  @default(false)

  // ── Gamification fields ─────────────────────────────────────────────────
  xp              Int      @default(0)
  level           Int      @default(1)
  previousRank    Int?     @map("previous_rank")
  badges          Json     @default("[]")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, cycleId])
  @@map("leaderboard_entry")
}

model BadgeDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  description String
  criteria    Json
  createdAt   DateTime @default(now())

  @@map("badge_definition")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  htmlBody  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_template")
}

// ─── Brand Config ────────────────────────────────────────────────────────────
// White-label branding singleton: only one active config at a time.

model BrandConfig {
  id              String   @id @default(cuid())
  companyName     String?
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#10b981")
  secondaryColor  String   @default("#1f2937")
  accentColor     String   @default("#6366f1")
  customDomain    String?
  emailFromName   String?
  emailFromAddress String?
  loginBackground String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([customDomain])
  @@map("brand_config")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  @@map("audit_log")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  @@map("webhook_endpoint")
}

model WebhookEvent {
  id           String    @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  status       String    @default("PENDING")
  responseCode Int?
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@map("webhook_event")
}

// ─── Interview (Time Zone & Calendar) ───────────────────────────────────────

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Interview {
  id              String          @id @default(cuid())
  candidateId     String
  evaluatorId     String?
  scheduledAt     DateTime
  duration        Int             @default(60)
  timezone        String          @default("UTC")
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  meetingLink     String?
  problemSolving  Int?
  techSkills      Int?
  communication   Int?
  culturalFit     Int?
  overallScore    Float?
  evaluatorNotes  String?
  scoredAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidate User  @relation("CandidateInterviews", fields: [candidateId], references: [id])
  evaluator User? @relation("EvaluatorInterviews", fields: [evaluatorId], references: [id])
  interviewEvaluators InterviewEvaluator[]
  interviewScores    InterviewScore[]
  interviewDrafts    InterviewDraft[]

  @@map("interview")
}

// ─── Interview Evaluator (multi-evaluator support) ─────────────────────────

model InterviewEvaluator {
  id          String @id @default(cuid())
  interviewId String
  userId      String
  role        String @default("EVALUATOR") // EVALUATOR, LEAD, SHADOW

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([interviewId, userId])
  @@map("interview_evaluator")
}

// ─── Scoring Dimension (configurable rubric) ───────────────────────────────

model ScoringDimension {
  id           String   @id @default(cuid())
  cycleId      String?
  name         String
  description  String?
  minScore     Int      @default(0)
  maxScore     Int      @default(100)
  weight       Float    @default(1.0)
  rubric       Json?
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interviewScores InterviewScore[]

  @@map("scoring_dimension")
}

model InterviewScore {
  id          String   @id @default(cuid())
  interviewId String
  evaluatorId String
  dimensionId String
  score       Int
  notes       String?
  submittedAt DateTime @default(now())

  interview  Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator  User             @relation(fields: [evaluatorId], references: [id])
  dimension  ScoringDimension @relation(fields: [dimensionId], references: [id])

  @@unique([interviewId, evaluatorId, dimensionId])
  @@map("interview_score")
}

model InterviewDraft {
  id          String   @id @default(cuid())
  interviewId String
  evaluatorId String
  scores      Json     @default("{}")
  notes       String   @default("")
  savedAt     DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator User      @relation(fields: [evaluatorId], references: [id])

  @@unique([interviewId, evaluatorId])
  @@map("interview_draft")
}
