# ─── Quick rebuild using pre-built .next output ─────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

RUN apk add --no-cache openssl postgresql-client

COPY --chown=nextjs:nodejs .next ./.next
COPY --chown=nextjs:nodejs prisma ./prisma
COPY --chown=nextjs:nodejs src/generated ./src/generated
COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs package.json ./package.json
COPY --chown=nextjs:nodejs next.config.ts ./next.config.ts
COPY --chown=nextjs:nodejs docker/backup ./docker/backup

# Need node_modules for runtime
RUN npm install --production --ignore-scripts 2>/dev/null || true

USER nextjs
EXPOSE 3000
ENV NODE_ENV=production PORT=3000 HOSTNAME="0.0.0.0" NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "start"]
