# ─── Olais Eval — Production Environment Variables ──────────────────────────
# Copy this file to .env.production and fill in your production values.
#   cp .env.production.example .env.production
# NEVER commit .env.production to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string for production.
# Host should be "db" when using Docker Compose (internal network).
DATABASE_URL=postgresql://olais:your-strong-password-here@db:5432/olais_eval

# ─── Authentication (Auth.js / NextAuth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-change-me-in-production
# Public-facing URL (must be https in production)
NEXTAUTH_URL=https://eval.olais.in

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 (use a different secret from AUTH_SECRET)
JWT_SECRET=your-jwt-secret-change-me-in-production

# ─── App Configuration ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Olais Eval
NEXT_PUBLIC_APP_URL=https://eval.olais.in

# ─── Campaign Settings ──────────────────────────────────────────────────────
# Maximum number of candidates per evaluation cycle
MAX_PARTICIPANTS=50
# Campaign deadline in ISO 8601 format
CAMPAIGN_DEADLINE=2026-12-31T23:59:59Z
# Whether the leaderboard is publicly visible (true/false)
LEADERBOARD_PUBLIC=true

# ─── Docker Compose Specific ────────────────────────────────────────────────
# PostgreSQL password (must match the password in DATABASE_URL)
DB_PASSWORD=your-strong-password-here

# ─── Optional ───────────────────────────────────────────────────────────────
# Set to 1 to disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
