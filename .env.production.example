# ─── Olais Eval — Production Environment Variables ───────────────────────────
# Copy this file to .env.production on the production server.
#   cp .env.production.example .env.production
# Ensure this file is NOT committed to version control (it's in .gitignore).
# Permissions: chmod 600 .env.production

# ─── Database ───────────────────────────────────────────────────────────────
# Use the Docker service name 'db' as host when running in containers
DATABASE_URL=postgresql://olais:CHANGE_ME_STRONG_PASSWORD@db:5432/olais_eval
# PostgreSQL password (also used by docker-compose.prod.yml for the DB container)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Authentication (Auth.js / NextAuth) ────────────────────────────────────
# Generate with: openssl rand -base64 32 (minimum 32 characters)
AUTH_SECRET=generate-me-with-openssl-rand-base64-32
# Must be the public-facing production URL
NEXTAUTH_URL=https://eval.olais.in

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 (separate from AUTH_SECRET)
JWT_SECRET=generate-me-with-openssl-rand-base64-32-different

# ─── App Configuration ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Olais Eval
NEXT_PUBLIC_APP_URL=https://eval.olais.in

# ─── Campaign Settings ──────────────────────────────────────────────────────
# Maximum number of candidates per evaluation cycle
MAX_PARTICIPANTS=50
# Campaign deadline in ISO 8601 format
CAMPAIGN_DEADLINE=2026-12-31T23:59:59Z
# Whether the leaderboard is publicly visible
LEADERBOARD_PUBLIC=true

# ─── Optional ───────────────────────────────────────────────────────────────
# Set to 1 to disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
